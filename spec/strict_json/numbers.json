   "doc": "-9223372036854775809",
   "expect": "accept"
  },
  {
   "name": "308 digits, all nines",
   "doc": "",
   "expect": "accept"
  },
  {
   "name": "309 digits: 10^308",
   "doc": "",
   "expect": "accept"
  },
  {
