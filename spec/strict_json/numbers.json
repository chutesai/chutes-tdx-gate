   "doc": "",
   "expect": "accept"
  },
  {
   "name": "309 digits: one below 2^1024 - 2^970 (reads as the largest float64)",
   "doc": "",
   "expect": "accept"
  },
  {
   "name": "309 digits: one below 2^1024 - 2^970, negative",
   "doc": "-",
   "expect": "accept"
  },
  {
   "name": "309 digits: 2^1024 - 2^970 (reads as infinity)",
   "doc": "",
   "expect": "refuse"
  },
  {
   "name": "309 digits: 2^1024 - 2^970, negative",
   "doc": "-",
   "expect": "refuse"
  },
  {
