   "doc": "0",
   "expect": "accept"
  },
  {
   "name": "negative zero",
   "doc": "-0",
   "expect": "accept"
  },
  {
   "name": "negative zero with a fraction and an exponent",
   "doc": "-0.0e-0",
   "expect": "accept"
  },
  {
   "name": "zero with an exponent beyond the float64 range",
   "doc": "0e400",
   "expect": "accept"
  },
  {
